rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isAdmin() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             (data.uid == request.auth.uid || isAdmin()) &&
             data.email is string && data.email.size() <= 256 &&
             (!data.keys().hasAny(['currency']) || (data.currency is string && data.currency.size() == 3));
    }

    function isValidAccount(data) {
      return data.keys().hasAll(['name', 'type', 'initialBalance', 'currentBalance', 'userId']) &&
             data.name is string && data.name.size() <= 100 &&
             data.type in ['wallet', 'card', 'bank'] &&
             data.userId == request.auth.uid &&
             data.initialBalance is number &&
             data.currentBalance is number;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'type', 'userId']) &&
             data.name is string && data.name.size() <= 50 &&
             data.type in ['expense', 'income'] &&
             data.userId == request.auth.uid;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['amount', 'type', 'categoryId', 'accountId', 'date', 'userId']) &&
             data.amount is number &&
             data.type in ['expense', 'income'] &&
             data.userId == request.auth.uid &&
             data.accountId is string && data.categoryId is string;
    }

    function isValidGroup(data) {
      return data.keys().hasAll(['name', 'ownerId', 'members']) &&
             data.name is string && data.name.size() <= 100 &&
             data.ownerId == request.auth.uid &&
             data.members is list && data.members.size() <= 100 &&
             request.auth.uid in data.members;
    }

    function isValidGroupExpense(data) {
      return data.keys().hasAll(['description', 'totalAmount', 'paidBy', 'groupId', 'splits', 'date']) &&
             data.description is string && data.description.size() <= 200 &&
             data.totalAmount is number &&
             data.paidBy is string &&
             data.groupId is string &&
             data.splits is list && data.splits.size() > 0 && data.splits.size() <= 100;
    }

    // Collection Matches
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && isValidUser(incoming()) && 
                    (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'currency']));
    }

    match /accounts/{accountId} {
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidAccount(incoming());
      allow update: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid && isValidAccount(incoming()));
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    match /categories/{categoryId} {
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidCategory(incoming());
      allow update: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid && isValidCategory(incoming()));
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    match /transactions/{transactionId} {
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidTransaction(incoming());
      allow update: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid && isValidTransaction(incoming()));
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    match /groups/{groupId} {
      allow list: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.members);
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.members);
      allow create: if isSignedIn() && isValidGroup(incoming());
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid in existing().members && isValidGroup(incoming()));
      allow delete: if isAdmin() || (isSignedIn() && existing().ownerId == request.auth.uid);
    }

    match /groupExpenses/{expenseId} {
      function canAccessGroup(groupId) {
        return isAdmin() || (exists(/databases/$(database)/documents/groups/$(groupId)) && 
               get(/databases/$(database)/documents/groups/$(groupId)).data.members.hasAny([request.auth.uid]));
      }
      
      allow list: if isSignedIn() && canAccessGroup(resource.data.groupId);
      allow get: if isSignedIn() && canAccessGroup(resource.data.groupId);
      allow create: if isSignedIn() && isValidGroupExpense(incoming()) && canAccessGroup(incoming().groupId);
      allow update: if isSignedIn() && canAccessGroup(existing().groupId) && isValidGroupExpense(incoming());
      allow delete: if isSignedIn() && (existing().paidBy == request.auth.uid || canAccessGroup(existing().groupId));
    }
  }
}
