# Splitify Backend Configuration

# Server Port
PORT=8080

# Database Configuration
# Supported: sqlite, postgres
DB_TYPE=postgres
DB_PATH=splitify.db
# Required for postgres:
DB_URL="host=localhost user=splitify password=your-password dbname=splitify port=5432 sslmode=disable"

# Google OAuth Configuration
# This MUST match the client ID used in the frontend
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
