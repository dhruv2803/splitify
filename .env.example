# Splitify Environment Variables

# Backend API URL
VITE_API_URL="http://localhost:8080"

# Google OAuth Configuration
# Obtain this from Google Cloud Console (APIs & Services > Credentials)
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# Database Configuration
# Supported: sqlite, postgres
DB_TYPE=sqlite
DB_URL="host=localhost user=splitify password=your-password dbname=splitify port=5432 sslmode=disable"

# Gemini AI API Key (Optional)
GEMINI_API_KEY="your-gemini-api-key"
